{
  "name": "perun-atlas",
  "version": "1.0.1-rc.1",
  "description": "Shared map layer for svarog bundles.",
  "main": "backend/www/perun-atlas.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerunTech/Perun-Atlas.git"
  },
  "files": [
    "backend/www/perun-atlas.js",
    "backend/www/*.perun-atlas.js"
  ],
  "dependencies": {
    "spatial": "npm:svarog-spatial@^4.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "but-unzip": "^0.1.10",
    "oxlint": "^1.85.0",
    "perun-core": "^4.5.8",
    "proj4": "2.10.0",
    "shpjs": "^6.2.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "vite build --config vite.modules.config.mjs && vite build",
    "dev": "vite build --config vite.modules.config.mjs && vite build --watch",
    "lint": "oxlint frontend/ test/",
    "lint:fix": "oxlint --fix frontend/ test/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
